# 包基础信息
pkgname=mcparser
pkgver=1.4.5
pkgrel=1
pkgdesc="A toolkit that can parse Minecraft community resources (such as mods)"
arch=('x86_64')
url="https://gitee.com/AngryMouse7891/mcparser"
license=('MIT')
# 编译依赖：cmake、编译器、构建工具；运行依赖按需添加
makedepends=('cmake' 'gcc' 'ninja')
depends=('fmt' 'jsoncpp' 'curl' 'openssl' 'ca-certificates')
# 源码，可以是本地文件或者git地址、压缩包
source=("../")
sha256sums=('SKIP')

# 构建函数：makepkg 自动执行
build() {
    mkdir -p build
    cd build
    cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -G "Ninja" ../../
    make -j$(nproc)
}

# 安装函数，make install 把文件部署到 makepkg 的临时打包目录 $pkgdir
package() {
    cd build
    make DESTDIR="$pkgdir" install
}
