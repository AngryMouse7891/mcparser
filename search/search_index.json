{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":""},{"location":"#mcparser","title":"<p> MCParser   </p>","text":""},{"location":"#_1","title":"\u6587\u6863\u5bfc\u822a","text":"<ul> <li> <p>\u4f7f\u7528\u65b9\u6cd5</p> </li> <li> <p>\u5f00\u53d1\u6307\u5357</p> </li> <li> <p>\u94fe\u63a5</p> </li> <li> <p>\u66f4\u65b0\u65e5\u5fd7</p> </li> </ul>"},{"location":"BUILD/","title":"\u5f00\u53d1\u6307\u5357","text":""},{"location":"BUILD/#_1","title":"\u901a\u7528\u5f00\u53d1\u8bf4\u660e","text":""},{"location":"BUILD/#windows","title":"Windows","text":"<ol> <li> <p>\u5b89\u88c5 MSYS2</p> </li> <li> <p>\u914d\u7f6e\u73af\u5883</p> </li> </ol> <p>\u5728MSYS2 UCRT64\u7ec8\u7aef\u4e2d\u8f93\u5165\u4ee5\u4e0b\u547d\u4ee4\u4ee5\u5b89\u88c5\u5de5\u5177\u94fe\u4ee5\u53ca\u5176\u5b83\u4f9d\u8d56\u7136\u540e\u914d\u7f6e\u73af\u5883\u53d8\u91cf\uff1a</p> <pre><code>pacman -S mingw-w64-ucrt-x86_64-{gcc,make,jsoncpp,curl,fmt,pkgconf,cmake} #\u5b89\u88c5GCC\u3001make\u3001jsoncpp\u3001cURL\u3001fmt\u3001OpenSSL\u3001pkg-config\u3001CMake\nexport PATH=/ucrt64/bin:$PATH\n</code></pre> <p>\u4f60\u4e5f\u53ef\u4ee5\u5c06Ninja\u4f5c\u4e3a\u5e95\u5c42\u6784\u5efa\u5de5\u5177\uff1a</p> <pre><code>pacman -S mingw-w64-ucrt-x86_64-ninja\n</code></pre> <p>\u5982\u679c\u4f60\u4e0d\u60f3\u901a\u8fc7MSYS2\u5b89\u88c5CMake\uff0c\u4f60\u4e5f\u53ef\u4ee5\u4ece CMake\u5b98\u7f51 \u4e0b\u8f7d\u5b89\u88c5\u3002</p> <ol> <li>\u83b7\u53d6\u6e90\u7801\uff1a</li> </ol> <p>\u901a\u8fc7Git\u514b\u9686\u8be5\u4ed3\u5e93\uff1a</p> <pre><code>pacman -S git #\u5b89\u88c5git\n\ngit clone https://gitee.com/AngryMouse7891/mcparser.git #\u514b\u9686\u4ed3\u5e93\n\ngit clone https://gitee.com/AngryMouse7891/mcparser.git --branch 1.5.1 #\u6216\u8005\u4ec5\u83b7\u53d6\u7279\u5b9a\u7248\u672c\u6216\u5206\u652f\n</code></pre> <p>\u5982\u679c\u4f60\u4e0d\u60f3\u901a\u8fc7MSYS2\u5b89\u88c5Git\uff0c\u4f60\u4e5f\u53ef\u4ee5\u4ece Git\u5b98\u7f51 \u4e0b\u8f7d\u5b89\u88c5\u3002</p> <ol> <li>\u6b63\u5f0f\u6784\u5efa\uff1a</li> </ol> <pre><code>cd mcparser #\u5207\u6362\u5230\u6e90\u7801\u76ee\u5f55\ncmake -S . -B build -DCMAKE_BUILD_TYPE=Release -G \"MinGW Makefiles\" #\u914d\u7f6e\u9879\u76ee\ncmake -S . -B build -DCMAKE_BUILD_TYPE=Release -G \"Ninja\" #\u82e5\u4f7f\u7528Ninja\ncd build #\u5207\u6362\u5230\u6784\u5efa\u76ee\u5f55\ncmake --build . -- -j $(nproc) #\u6784\u5efa\u9879\u76ee\uff08\u6700\u5927\u7ebf\u7a0b\uff09\n</code></pre> <p>\u4e0a\u8ff0\u6b65\u9aa4\u5b8c\u6210\u540e\uff0c<code>build/mcparser.exe</code>\u5c31\u662f\u6784\u5efa\u4e4b\u540e\u7684\u6587\u4ef6\u3002</p> <ol> <li>\u6253\u5305\uff08\u53ef\u9009\uff09</li> </ol> <p>\u5728MSYS2\u4e2d\u5b89\u88c5NSIS\u5e76\u914d\u7f6e\uff1a</p> <pre><code>pacman -S mingw-w64-ucrt-x86_64-nsis #\u5b89\u88c5NSIS\n</code></pre> <p>\u5982\u679c\u4f60\u4e0d\u60f3\u901a\u8fc7MSYS2\u5b89\u88c5NSIS\uff0c\u4f60\u4e5f\u53ef\u4ee5\u4ece NSIS\u5b98\u7f51 \u4e0b\u8f7d\u5b89\u88c5\u3002</p> <p>\u4e4b\u540e\u5728\u6e90\u7801\u76ee\u5f55\u4e0b\u7684<code>build</code>\u76ee\u5f55\u8fd0\u884c\u547d\u4ee4\uff1a</p> <pre><code>cpack -C Release #\u901a\u8fc7CPack\u6253\u5305\n</code></pre> <p>\u6253\u5305\u5b8c\u6210\u540e\uff0c\u4f1a\u51fa\u73b0\u4e24\u4e2a\u6587\u4ef6\uff1a</p> <p><code>MCParser_xxx_xxx_xxxxxxxx_xxxxxx_x.x.x.exe</code></p> <p><code>MCParser_xxx_xxx_xxxxxxxx_xxxxxx_x.x.x.zip</code></p> <p>\u8fd9\u5c31\u662f\u6253\u5305\u4e4b\u540e\u7684\u6587\u4ef6\u3002</p>"},{"location":"BUILD/#linux","title":"Linux","text":"<ol> <li>\u914d\u7f6e\u73af\u5883</li> </ol> <pre><code>sudo pacman -S fmt jsoncpp curl cmake make pkgconf #\u5982\u679c\u662fArch Linux\nsudo zypper in libfmt12 fmt-devel jsoncpp-devel libjsoncpp27 libcurl-devel libcurl4 pkgconf pkgconf-pkg-config #\u5982\u679c\u662f openSUSE\n</code></pre> <p>\u4f60\u4e5f\u53ef\u4ee5\u5c06Ninja\u4f5c\u4e3a\u5e95\u5c42\u6784\u5efa\u5de5\u5177\uff1a</p> <pre><code>sudo pacman -S ninja #\u5982\u679c\u662fArch Linux\nsudo zypper in ninja #\u5982\u679c\u662f openSUSE\n</code></pre> <ol> <li>\u83b7\u53d6\u6e90\u7801\uff1a</li> </ol> <p>\u901a\u8fc7Git\u514b\u9686\u8be5\u4ed3\u5e93\uff1a</p> <pre><code>sudo pacman -S git #\u5b89\u88c5git\uff08\u5982\u679c\u662fArch Linux\uff09\nsudo zypper in git #\u5982\u679c\u662f openSUSE\n\ngit clone https://gitee.com/AngryMouse7891/mcparser.git #\u514b\u9686\u4ed3\u5e93\n\ngit clone https://gitee.com/AngryMouse7891/mcparser.git --branch 1.5.1 #\u6216\u8005\u4ec5\u83b7\u53d6\u7279\u5b9a\u7248\u672c\u6216\u5206\u652f\n</code></pre> <ol> <li>\u6b63\u5f0f\u6784\u5efa\uff1a</li> </ol> <pre><code>cd mcparser #\u5207\u6362\u5230\u6e90\u7801\u76ee\u5f55\ncmake -S . -B build -DCMAKE_BUILD_TYPE=Release -G \"Unix Makefiles\" #\u914d\u7f6e\u9879\u76ee\ncmake -S . -B build -DCMAKE_BUILD_TYPE=Release -G \"Ninja\" #\u82e5\u4f7f\u7528Ninja\ncd build #\u5207\u6362\u5230\u6784\u5efa\u76ee\u5f55\ncmake --build . -- -j $(nproc) #\u6784\u5efa\u9879\u76ee\uff08\u6700\u5927\u7ebf\u7a0b\uff09\n</code></pre> <p>\u4e0a\u8ff0\u6b65\u9aa4\u5b8c\u6210\u540e\uff0c<code>build/mcparser</code>\u5c31\u662f\u6784\u5efa\u4e4b\u540e\u7684\u6587\u4ef6\u3002</p> <ol> <li>\u6253\u5305\uff08\u53ef\u9009\uff09</li> </ol> <p>\u5728\u6e90\u7801\u76ee\u5f55\u4e0b\u7684<code>build</code>\u76ee\u5f55\u8fd0\u884c\u547d\u4ee4\uff1a</p> <pre><code>cpack -C Release #\u901a\u8fc7CPack\u6253\u5305\n</code></pre>"},{"location":"CHANGELOG/","title":"\u66f4\u65b0\u65e5\u5fd7","text":""},{"location":"CHANGELOG/#mcparser","title":"MCParser\u53d1\u884c\u6ce8\u8bb0","text":""},{"location":"CHANGELOG/#151-2026924","title":"1.5.1 (2026/9/24)","text":"<ul> <li>\u66f4\u65b0\u5c01\u9762</li> <li>\u5220\u9664\u591a\u4f59\u6587\u6863</li> <li>\u6dfb\u52a0\u66f4\u591a\u989c\u6587\u5b57\u548cemoji</li> <li>\u6dfb\u52a07\u53e5\u95ea\u70c1\u6807\u8bed</li> <li>\u6dfb\u52a0\u90ae\u7