#include <windows.h> // include for version info constants

MCParser ICON "@CMAKE_SOURCE_DIR@/data/mcparser.ico"

#define RT_MANIFEST 24
1 RT_MANIFEST "@CMAKE_SOURCE_DIR@/mcparser.exe.manifest"

//
// TO CHANGE VERSION INFORMATION, EDIT PROJECT OPTIONS...
//
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0 
FILETYPE VFT_APP
{
  BLOCK "StringFileInfo"
  {
    BLOCK "080404e4"
    {
      VALUE "CompanyName", "AngryMouse7891"
      VALUE "FileVersion", "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
      VALUE "FileDescription", "一个一个一个一个一个一个一个一个一个一个一个一个一个解析《我的世界》社区资源（如模组）的工具。"
      VALUE "InternalName", "MCParser"
      VALUE "LegalCopyright", "Copyright (c) 2026 红温的鼠鼠7891"
      VALUE "LegalTrademarks", ""
      VALUE "OriginalFilename", "mcparser.exe"
      VALUE "ProductName", "MCParser"
      VALUE "ProductVersion", "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x0804, 1252
  }
}